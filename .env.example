# ──────────────────────────────────────────────────────────────────────────────
#  Variables d'environnement — copie ce fichier en .env et complète les valeurs.
#  Sur Railway, déclare ces variables dans l'onglet « Variables » du service.
# ──────────────────────────────────────────────────────────────────────────────

# ── OBLIGATOIRE ───────────────────────────────────────────────────────────────
# Token du bot fourni par @BotFather.
BOT_TOKEN=123456:ABC-DEF...

# Id du supergroupe (forum) cible. Doit commencer par -100.
# Active « Topics » dans les réglages du groupe, ajoute le bot en admin avec le
# droit « Gérer les sujets ». Récupère l'id via @username_to_id_bot ou les logs.
TARGET_CHAT_ID=-1001234567890

# ── ACCÈS (recommandé) ────────────────────────────────────────────────────────
# Ids utilisateurs autorisés à piloter le bot, séparés par des virgules.
# Vide = ouvert à tous (déconseillé en production).
ADMIN_USER_IDS=11111111,22222222

# ── BASE DE DONNÉES ───────────────────────────────────────────────────────────
# Local (par défaut) : SQLite. Sur Railway, ajoute un plugin PostgreSQL et colle
# l'URL fournie (passe postgresql:// en postgresql+asyncpg://).
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# ── ANTI-DÉTECTION / X ────────────────────────────────────────────────────────
# Cookies X — DEUX méthodes (X exige souvent une session connectée) :
#
#  • Méthode « cloud » (recommandée, zéro fichier local) : colle TOUT le contenu
#    du fichier cookies.txt (format Netscape) dans cette variable. Le bot écrira
#    le fichier tout seul au démarrage. Sur Railway, utilise un champ multiligne.
# X_COOKIES_CONTENT=
#
#  • Méthode fichier : si tu montes un vrai fichier, indique son chemin ici.
# X_COOKIES_FILE=/app/data/x_cookies.txt

# Proxys (séparés par des virgules), ex : http://user:pass@ip:port,http://ip2:port
PROXIES=

# Délais aléatoires entre requêtes X (lissage anti rate-limit).
MIN_REQUEST_DELAY=1.5
MAX_REQUEST_DELAY=4.0

# ── TÉLÉCHARGEMENT ────────────────────────────────────────────────────────────
DEFAULT_MEDIA_LIMIT=50
HARD_MEDIA_CAP=2000
WORK_DIR=./data/downloads
MAX_UPLOAD_BYTES=51380224

# ── CONCURRENCE ───────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=3
DOWNLOAD_CONCURRENCY=2

# ── RETRY ─────────────────────────────────────────────────────────────────────
MAX_RETRIES=5
RETRY_BASE_DELAY=2.0
RETRY_MAX_DELAY=120.0

# ── LOGGING ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
